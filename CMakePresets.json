{
    "version": 6,
    "cmakeMinimumRequired": { "major": 4, "minor": 3, "patch": 0 },
    "configurePresets": [
        {
            "name": "vs2026",
            "displayName": "Visual Studio 2026 solution (projects/)",
            "description": "Generates the Visual Studio solution and projects into projects/.",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/projects"
        }
    ],
    "buildPresets": [
        { "name": "vs2026-debug",   "configurePreset": "vs2026",  "configuration": "Debug" },
        { "name": "vs2026-release", "configurePreset": "vs2026",  "configuration": "Release" }
    ]
}
